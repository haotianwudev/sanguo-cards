      "border": "#4b5263", "track": "#3b3f4a", "text": "#d7dae0", "muted": "#abb2bf", "dim": "#5c6370",
      "gold": "#f5c542", "red": "#e06c75", "enemy-border": "#be5046", "green": "#98c379", "amber": "#e5c07b",
      "blue": "#61afef", "purple": "#c678dd", "gray": "#8b949e"
    },
    "light": {
      "bg": "#f6f3ea", "panel": "#ebe6d9", "card": "#fffdf7", "card-hover": "#f3eee2", "card-ssr": "#fff6d8",
      "spent": "#e9e6df", "log-bg": "#fbf9f3", "enemy-bg": "#fbecea", "party-bg": "#edf5ea", "sel-bg": "#fff1c4",
      "border": "#b9b2a3", "track": "#d6d0c3", "text": "#2b2b2b", "muted": "#5f6368", "dim": "#9a968c",
      "gold": "#b7791f", "red": "#c0392b", "enemy-border": "#c0392b", "green": "#2e7d32", "amber": "#a8660a",
      "blue": "#1f6fb2", "purple": "#8e44ad", "gray": "#7a7a7a"
    }
  },
  "rarity_labels": {"N": "兵", "R": "R", "SR": "SR", "SSR": "SSR", "lord": "主公"},
  "rarity_colors": {"N": "gray", "R": "blue", "SR": "purple", "SSR": "gold", "lord": "red"},
  "map": {
    "cell": 8,
    "glyphs": {"event": "事", "choose": "选", "battle": "战", "treasure": "宝", "recover": "休", "recruit": "募", "boss": "将"},
    "type_names": {"event": "剧情", "choose": "抉择", "battle": "战斗", "treasure": "宝箱", "recover": "回复", "recruit": "招募"},
    "type_colors": {"battle": "red", "boss": "purple", "treasure": "gold", "recover": "blue", "choose": "amber", "recruit": "green", "event": "text"}
  },
  "card": {
    "_comment": "frame art per rarity (see pics/CARD-DESIGN.md). Window/plate come from art/frames/frames.json; missing entries fall back to drawn frames",
    "frames": {"N": "wood", "R": "bronze", "SR": "silver", "SSR": "ssr", "lord": "gold", "enemy": "iron"},
    "plate": [0.29, 0.875, 0.42, 0.075],
    "_plates": "per-frame name plate [x, y, w, h] as fractions of the card; frames without a plate get a drawn band",
    "plates": {"wood": [0.30, 0.874, 0.40, 0.076], "bronze": [0.30, 0.872, 0.40, 0.078], "silver": [0.30, 0.882, 0.40, 0.074],
               "gold": [0.30, 0.872, 0.40, 0.08], "ssr": [0.30, 0.868, 0.40, 0.08], "iron": [0.28, 0.87, 0.44, 0.08]},
    "_badges": "troop badge centre per frame [x, y] as fractions of the card — sits on the top-left corner gem",
    "badges": {"wood": [0.080, 0.078], "bronze": [0.080, 0.064], "silver": [0.088, 0.067], "ssr": [0.112, 0.071],
               "gold": [0.116, 0.071], "iron": [0.070, 0.064], "other": [0.075, 0.055]},
    "badge_size": 0.19,
    "name_font": ["KaiTi", "STKaiti", "Kaiti SC", "Noto Serif CJK SC", "SimSun"],
    "_name_styles": "name text per frame: engraved (dark text + light shadow) on metal, light text + dark outline on dark plates",
    "name_styles": {
      "wood":   {"color": "#f6e7c8", "outline": "#3a2412"},
      "bronze": {"color": "#2e1a08", "shadow": "#f3cf98"},
      "silver": {"color": "#1d2533", "shadow": "#ffffff"},
      "gold":   {"color": "#4a2a00", "shadow": "#fff3c4"},
      "ssr":    {"color": "#ffe7a0", "outline": "#1b1640"},
      "iron":   {"color": "#1c1f24", "shadow": "#eef1f5"},
      "none":   {"color": "#ffffff", "outline": "#000000"}
    }
  },
  "portrait_framing": {
    "_comment": "how many head-heights tall each portrait box shows (≈2.5 bust, ≈5.5 half body, large = whole picture)",
    "card": 2.6, "leader": 2.6, "story": 5.5, "collection": 99, "enemy": 2.4
  }
}
