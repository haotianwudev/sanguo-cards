{
  "_comment": "Presentation config for the terminal UI. Colour values in rarity_colors / map colours are palette names from themes.*",
  "default_theme": "light",
  "themes": {
    "dark": {
      "bg": "#1b1c21", "panel": "#25262c", "card": "#23242a", "card-hover": "#2c2e36", "card-ssr": "#2a2720",
