{
  "_doc": "Every data check that is 'this name must exist' / 'this value must be one of these' lives here, run by Schema.check (scripts/core/schema.gd explains the path syntax). The top level is cards.json and its parts, plus story / endings / ui / side_stories. GameData collects every failure at load (GameData.errors) and test_data_has_no_schema_errors prints them all at once.",
  "rules": [
    {"refs": "cards.*.troop", "to": "troops.@keys"},
    {"refs": "cards.*.skills.*", "to": "skills.@keys"},
    {"refs": "cards.*.kit", "to": "kits.@keys"},
    {"enum": "cards.*.scope", "values": ["", "south", "north"]},
    {"refs": "kits.*.normal.*", "to": "skills.@keys"},
    {"refs": "kits.*.special.*", "to": "skills.@keys"},
    {"refs": "troops.@keys", "to": "kit_default.@keys", "why": "every troop needs a default kit"},
    {"refs": "kit_default.*", "to": "kits.@keys"},
    {"each": "kits.*", "required": "normal"},
    {"each": "kits.*", "required": "special"},
    {"refs": "lord_forms.forms.*.skills.*", "to": "skills.@keys"},
    {"refs": "relics.*.troop", "to": "troops.@keys"},
    {"enum": "relics.*.rarity", "values": ["common", "rare", "curse", "story"]},
    {"enum": "fates.*.rarity", "values": ["common", "rare", "curse", "bad", "divine"]},

    {"enum": "skills.*.effects.*.type", "values": ["attack", "magic", "heal", "guard", "boost", "stun", "break", "ap", "burn", "counter", "hurt", "cleanse", "buff", "poison", "loot", "shred", "interrupt"]},
    {"enum": "skills.*.effects.*.vs.@keys", "values": ["broken", "burning", "poisoned", "stunned", "charging", "guarded", "stance", "marking", "shielded", "formation"]},
    {"enum": "skills.*.effects.*.crit_if", "values": ["broken", "burning", "poisoned", "stunned", "charging", "guarded", "stance", "marking", "shielded", "formation"]},

    {"refs": "enemies.*.card", "to": "cards.@keys"},
    {"refs": "enemies.*.drop", "to": "cards.@keys"},
    {"refs": "enemies.*.armor", "to": "battle.armors.@keys"},
    {"refs": "battle.troop_armor.*", "to": "battle.armors.@keys"},
    {"refs": "battle.troop_counter.*", "to": "troops.@keys"},
    {"refs": "battle.troop_counter.@keys", "to": "troops.@keys"},
    {"each": "enemies.*", "refs": "moves.*.charge", "to": "moves.*.name", "why": "charges a move the enemy doesn't have"},
    {"each": "enemies.*", "refs": "moves.*.chain", "to": "moves.*.name", "optional": true},
    {"each": "enemies.*", "refs": "moves.*.mark", "to": "moves.*.name"},
    {"enum": "enemies.*.moves.*.seal", "values": ["ultimate", "magic", "attack"]},
    {"enum": "enemies.*.moves.*.formation.vs", "values": ["attack", "magic"]},
    {"each": "enemies.*.moves.*.shield", "required": "hp_pct"},
    {"each": "enemies.*.moves.*.stance", "required": "power"},
    {"each": "enemies.*.moves.*.summon", "required": "name"},
    {"each": "enemies.*.moves.*.summon", "required": "hp_pct"},
    {"refs": "scenarios.*.enemy", "to": "enemies.@keys"},
    {"refs": "cards.*.voice", "to": "audio.voices.@keys"},
    {"refs": "enemies.*.voice", "to": "audio.voices.@keys", "optional": true},

    {"each": "story.quests.*", "refs": "start", "to": "squares.@keys"},
    {"each": "story.quests.*", "refs": "squares.*.next.*", "to": "squares.@keys"},
    {"each": "story.quests.*", "refs": "squares.*.choose.*.goto", "to": "squares.@keys"},
    {"each": "story.quests.*", "refs": "squares.*.lose_goto", "to": "squares.@keys"},
    {"unique": "story.quests.*.id"},
    {"refs": "story.routes.*", "to": "story.quests.*.squares.*.choose.*.record", "why": "a route's birth line must be a choice the game records"},
    {"refs": "story.quests.*.squares.*.type", "to": "ui.map.type_names.@keys"},
    {"refs": "story.quests.*.squares.*.battle", "to": "scenarios.@keys"},
    {"refs": "story.quests.*.squares.*.event", "to": "story.events.@keys"},
    {"refs": "story.quests.*.squares.*.cards.*", "to": ["cards.@keys", {"path": "lord_forms.forms.@keys", "prefix": "lord:"}]},
    {"refs": "story.quests.*.squares.*.card_unless.@keys", "to": "cards.@keys"},
    {"refs": "story.quests.*.squares.*.choose.*.card", "to": "cards.@keys"},
    {"refs": "story.quests.*.squares.*.relics.*", "to": "relics.@keys"},
    {"refs": "story.quests.*.squares.*.recruit_pool.*", "to": "cards.@keys"},
    {"refs": "story.quests.*.squares.*.soldier_pool.*", "to": "cards.@keys"},
    {"refs": "story.quests.*.recruit_pool.*", "to": "cards.@keys"},
    {"refs": "story.quests.*.soldier_pool.*", "to": "cards.@keys"},
    {"refs": "story.quests.*.chest_pool.*", "to": "cards.@keys"},
    {"refs": "story.quests.*.pool_overrides.*.recruit_pool.*", "to": "cards.@keys"},
    {"refs": "story.quests.*.event_pool.*", "to": "story.events.@keys", "optional": true},
    {"refs": "story.quests.*.ending", "to": "endings.endings.@keys"},
    {"enum": "story.quests.*.soldier_scope", "values": ["", "south", "north"]},
    {"enum": "story.quests.*.pool_overrides.*.soldier_scope", "values": ["", "south", "north"]},

    {"refs": "story.events.*.scope", "to": "story.quests.*.id", "also": ["universal", "south", "north", "fixed"]},
    {"each": "ui.themes.*", "refs": "/story.events.*.color", "to": "@keys", "why": "the map paints a ？ square in its event's colour from the theme (a missing one crashed the map)"},
    {"enum": "story.events.*.route", "values": ["", "south", "north"]},
    {"refs": "story.events.*.options.**.battle", "to": "scenarios.@keys"},
    {"refs": "story.events.*.options.**.card", "to": ["cards.@keys", {"path": "lord_forms.forms.@keys", "prefix": "lord:"}]},
    {"refs": "story.events.*.options.**.offer.from.*", "to": "cards.@keys"},
    {"refs": "story.events.*.options.**.relic", "to": "relics.@keys"},

    {"refs": "side_stories.after.@keys", "to": "story.quests.*.id"},
    {"refs": "side_stories.after.*.*.portraits.*", "to": "portraits.@keys", "why": "a ？小故事 only shows people whose portrait is drawn"},
    {"refs": "side_stories.chapters.@keys", "to": "story.quests.*.id"},
    {"refs": "side_stories.chapters.*.*.card", "to": "cards.@keys", "optional": true},
    {"unique": "side_stories.after.*.*.id"},
    {"each": "side_stories.after.*.*", "required": "text"},
    {"each": "side_stories.after.*.*", "required": "reward", "why": "every ？小故事 names a reward"},
    {"forbid": "side_stories.after.*.*.reward.merit", "why": "rewards are cards / 点化 / 宝物, never 战功 (user rule)"},
    {"refs": "side_stories.after.*.*.reward.cards.*", "to": ["cards.@keys", {"path": "lord_forms.forms.@keys", "prefix": "lord:"}]},
    {"refs": "side_stories.after.*.*.reward.upgrade.@keys", "to": ["cards.@keys", {"path": "lord_forms.forms.@keys", "prefix": "lord:"}]},
    {"refs": "side_stories.after.*.*.reward.relics.*", "to": "relics.@keys"},
    {"forbid": "side_stories.after.*.*.reward.cards.*", "matching": "^sunjian", "why": "never hands out a 孙坚 card (user rule)"},
    {"forbid": "side_stories.after.*.*.reward.upgrade.@keys", "matching": "^sunjian", "why": "never hands out a 孙坚 card (user rule)"},

    {"refs": "story.quests.*.requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.unless.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.squares.*.requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.squares.*.unless.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.squares.*.ghost_requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.squares.*.card_unless.*.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.squares.*.choose.*.requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.pool_overrides.*.requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.pool_overrides.*.unless.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records", "optional": true},
    {"refs": "story.quests.*.title_overrides.*.requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.title_overrides.*.unless.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records", "optional": true},
    {"refs": "story.quests.*.map_overrides.*.requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "story.quests.*.map_overrides.*.unless.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records", "optional": true},
    {"refs": "side_stories.after.*.*.requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "side_stories.after.*.*.unless.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "side_stories.chapters.*.*.requires.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"},
    {"refs": "side_stories.chapters.*.*.unless.*", "to": ["story.quests.*.squares.*.record", "story.quests.*.squares.*.record_win", "story.quests.*.squares.*.record_lose", "story.quests.*.squares.*.choose.*.record", "story.events.**.record", "endings.endings.*.title"], "why": "a gate names a line nothing records"}
  ]
}
