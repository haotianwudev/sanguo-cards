#!/bin/sh
# Keep docs/CHAPTER-STATS.md in step with the data it summarises: whenever story / cards / art data is part of a commit,
# regenerate the stats (squares, battles, CGs, pools, 南北线对比, 卡牌种类) and the roster (docs/ROSTER.md: every soldier / general,
# where it comes from, which soldiers each chapter hands out) and add both docs to the same commit.
# Install once per clone:  git config core.hooksPath tools/hooks
if git diff --cached --name-only | grep -qE '^godot/data/(story|cards|enemies|scenarios|skills|relics|battle|endings)\.json$|^pics/art\.json$|^tools/(art_prompts|art_prompts_zh|chapter_docs|roster|chapter_stats)\.py$'; then
	python tools/chapter_stats.py --write >/dev/null || { echo "pre-commit: tools/chapter_stats.py failed — fix it (or the data JSON) first" >&2; exit 1; }
	git add docs/CHAPTER-STATS.md
	python tools/roster.py --write >/dev/null || { echo "pre-commit: tools/roster.py failed — fix it (or the data JSON) first" >&2; exit 1; }
	git add docs/ROSTER.md
	python tools/chapter_docs.py >/dev/null || { echo "pre-commit: tools/chapter_docs.py failed — fix it (or the data JSON) first" >&2; exit 1; }
	git add docs/chapters
fi
